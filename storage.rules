rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===============================================================
    // Helper Functions for Administrator Verification
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedBootstrapOwner() {
      return isAuthenticated() &&
        request.auth.token.email == 'ayushprakash0021@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function hasAdminDoc() {
      return isAuthenticated() && (
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin' &&
         firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true) ||
        (firestore.exists(/databases/ai-studio-orion9theintelli-c9e042d6-9d0a-4a41-91ee-a78214c20b1b/documents/admins/$(request.auth.uid)) &&
         firestore.get(/databases/ai-studio-orion9theintelli-c9e042d6-9d0a-4a41-91ee-a78214c20b1b/documents/admins/$(request.auth.uid)).data.role == 'admin' &&
         firestore.get(/databases/ai-studio-orion9theintelli-c9e042d6-9d0a-4a41-91ee-a78214c20b1b/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        isVerifiedBootstrapOwner() ||
        hasAdminDoc()
      );
    }

    function isValidLogoUpload() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|svg\\+xml)');
    }

    // ===============================================================
    // 1. Website Branding Logos
    // Public read for live website visitors.
    // Upload (write) and delete restricted strictly to verified administrators.
    // ===============================================================
    match /branding/logos/{filename} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidLogoUpload();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. Desktop Installers & Releases (Optional public distribution)
    // ===============================================================
    match /installers/{version}/{filename} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size <= 250 * 1024 * 1024 &&
        (
          filename.matches('.*\\.exe$') ||
          filename.matches('.*\\.msi$') ||
          filename.matches('.*\\.dmg$') ||
          filename.matches('.*\\.zip$') ||
          filename.matches('.*\\.tar\\.gz$')
        );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 3. Default Deny for all other storage paths
    // ===============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
