{
  "entities": {
    "SiteConfigSection": {
      "title": "SiteConfigSection",
      "description": "Published or draft structured configuration document for Orion-9 CMS sections",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last configuration update"
        },
        "updatedBy": {
          "type": "string",
          "description": "Administrator email or UID that published the update"
        }
      },
      "required": ["updatedAt", "updatedBy"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Orion-9 operator profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID"
        },
        "username": {
          "type": "string",
          "description": "Unique chosen operator username"
        },
        "normalizedUsername": {
          "type": "string",
          "description": "Lowercase normalized username"
        },
        "displayName": {
          "type": "string",
          "description": "Operator full name"
        },
        "email": {
          "type": "string",
          "description": "Operator email address"
        },
        "role": {
          "type": "string",
          "enum": ["operator", "admin"],
          "description": "Non-escalatable operator role"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "UsernameRecord": {
      "title": "UsernameRecord",
      "description": "One-to-one username index mapping to account email and UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner"
        },
        "username": {
          "type": "string",
          "description": "User-chosen username"
        },
        "normalizedUsername": {
          "type": "string",
          "description": "Normalized lowercase username"
        },
        "email": {
          "type": "string",
          "description": "Account email address"
        }
      },
      "required": ["uid", "username", "normalizedUsername", "email"]
    },
    "AdminAclRecord": {
      "title": "AdminAclRecord",
      "description": "Server-side administrator role assignment in /admins/{uid}",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Administrator email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "editor", "viewer"],
          "description": "Administrative permission tier"
        },
        "active": {
          "type": "boolean",
          "description": "Whether administrator privileges are currently active"
        },
        "grantedBy": {
          "type": "string",
          "description": "UID or email of granting administrator"
        }
      },
      "required": ["email", "role", "active"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable administrative change log entry",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string"
        },
        "actorEmail": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": ["publish", "save_draft", "reset_defaults", "auth_config", "role_check"]
        },
        "summary": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": ["actorUid", "actorEmail", "section", "action", "summary", "timestamp"]
    },
    "DesktopRelease": {
      "title": "DesktopRelease",
      "description": "Desktop installer release record for Windows and macOS distributions",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "platform": { "type": "string", "enum": ["windows-x64", "windows-arm64", "macos-universal", "macos-arm64", "macos-x64"] },
        "format": { "type": "string", "enum": ["exe", "msi", "dmg", "pkg"] },
        "status": { "type": "string", "enum": ["published", "draft", "disabled", "retired"] },
        "filename": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "sha256": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "channel": { "type": "string", "enum": ["stable", "beta"] },
        "isLatest": { "type": "boolean" },
        "downloadCount": { "type": "integer" },
        "minimumOs": { "type": "string" }
      },
      "required": ["version", "platform", "format", "status", "sha256"]
    }
  },
  "firestore": {
    "/siteConfig/{sectionId}": {
      "schema": {
        "$ref": "#/entities/SiteConfigSection"
      },
      "description": "Publicly readable, admin-writable published CMS configuration sections"
    },
    "/siteConfigDrafts/{sectionId}": {
      "schema": {
        "$ref": "#/entities/SiteConfigSection"
      },
      "description": "Admin-only draft CMS configuration sections"
    },
    "/releases/{releaseId}": {
      "schema": {
        "$ref": "#/entities/DesktopRelease"
      },
      "description": "Authenticated read, admin-only write desktop releases registry"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Operator user profiles"
    },
    "/usernames/{normalizedUsername}": {
      "schema": {
        "$ref": "#/entities/UsernameRecord"
      },
      "description": "Username to account resolution index (anti-enumeration: get only, no list)"
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminAclRecord"
      },
      "description": "Administrator role registry"
    },
    "/auditLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/AuditLogEntry"
      },
      "description": "Append-only administrative audit trail"
    }
  }
}
